<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Perfil Asesor</title>
    <link rel="stylesheet" href="/styles/estilos.css">
</head>
<body>

    <div class="perfil-container">
        <h1>Mi perfil</h1>

        <div class="card-usuario">
            <div class="foto-perfil"></div>
            <div class="info-texto">
                <h2 style="margin:0;">Eimi Camila Cervantes</h2>
                <p>eimicaci.ti24@utsjr.edu.mx</p>
                <span style="background: var(--verde-claro); padding: 5px 15px; border-radius: 5px;">Asesor</span>
            </div>
        </div>

        <div style="display: flex; gap: 50px; margin-top: 30px;">
            <div style="flex: 1;">
                <h3>Carrera:</h3>
                <p>Tecnologías de la información</p>
                
                <h3>Cuatrimestre:</h3>
