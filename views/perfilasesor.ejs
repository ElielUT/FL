                    <div class="materia">Bases de datos</div>
                    <div class="materia">Cálculo diferencial</div>
                    <div class="materia">Programación (POO)</div>
                </div>
            </div>

            <div style="flex: 1;">
                <h3>Disponibilidad</h3>
                <div class="horario-item">Lunes 14:00-16:00</div>
                <div class="horario-item">Miércoles 14:00-16:00</div>
                <div class="horario-item">Viernes 14:00-16:00</div>

                <div style="margin-top: 40px;">
                    <h3>Calificaciones</h3>
                    <div style="font-size: 48px; font-weight: bold; color: #333;">5.0</div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>