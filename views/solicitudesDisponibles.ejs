<%- include('templates/header.ejs') %>

    <div class="supervisar-container">
        <div class="supervisar-header">
            <h1>Solicitudes disponibles</h1>
            <p>Acepta las asesorías en las que puedas apoyar</p>
        </div>

        <!-- Lista de solicitudes listadas de forma similar a asesorias -->
        <div class="asesorias-grid">
            <div class="asesoria-card">

                <div class="card-header-info">
                    <h3>Proyecto integrador</h3>
                    <!-- Cambiado de span a button interactivo -->
                    <button type="button" class="status-badge badge-green" style="border: none; cursor: pointer;"
                        onclick="abrirModal()">
                        <i class="fas fa-check-circle"></i> Registrar
                    </button>
                </div>

                <div class="card-users">
                    <span>Solicitada por: Yael Izaid Meza</span>
                </div>

                <div class="card-datetime">
                    <span><i class="far fa-calendar-alt"></i> 09/03/26</span>
                    <span><i class="far fa-clock"></i> 14:00</span>
                </div>

                <div class="card-footer">
                    <span class="req-date">Solicitada el 05/01/26</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para confirmar e ingresar Tema (Oculto) -->
    <div id="modalRegistro" class="editarUsuario ocultar">
        <div class="asesoria-card" style="width: 90%; max-width: 500px; box-shadow: none;">

            <div class="card-header-info">
                <h3 style="font-size: 1.5rem;">Aceptar Solicitud</h3>
            </div>

            <!-- Datos de la Asesoría -->
            <div class="card-users" style="margin-top: 15px;">
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <span><strong>Materia:</strong> Proyecto integrador</span>
                    <span><strong>Estudiante:</strong> Yael Izaid Meza</span>
                </div>
            </div>

            <div class="card-datetime" style="margin-top: 15px; margin-bottom: 25px; font-size: 1rem;">
                <span><i class="far fa-calendar-alt"></i> 09/03/26</span>
                <span><i class="far fa-clock"></i> 14:00</span>
            </div>

            <!-- Sección para asignar el Tema -->
            <div>
                <label style="font-weight: 600; color: #333; font-size: 1.05rem;">Tema de la asesoría:</label>
                <!-- Utilizamos un componente de entrada (estilo de búsqueda) propio del proyecto -->
                <div class="search-box-materias" style="margin-top: 10px;">
                    <input type="text" id="temaAsesoria" style="width: 100%; border: none; outline: none;"
                        placeholder="Ej. Capítulo 3, Funciones derivables...">
                </div>
            </div>

            <!-- Botones de Acción -->
            <div class="contenedor-botones" style="margin-top: 30px;">
                <button type="button" class="btn-cancelar" onclick="cerrarModal()">Cancelar</button>
                <button type="button" class="btn-guardar" onclick="confirmarRegistro()">Confirmar</button>
            </div>

        </div>
    </div>

    <!-- Pequeño bloque JS para controlar el Modal -->
    <script>
        function abrirModal() {
            document.getElementById('modalRegistro').classList.remove('ocultar');
        }

        function cerrarModal() {
            const modal = document.getElementById('modalRegistro');
            modal.classList.add('ocultar');
            // Limpiamos el texto ingresado
            document.getElementById('temaAsesoria').value = '';
        }

        function confirmarRegistro() {
            // Interacción puramente visual: solo cierra la ventana emergente 
            // simulando que la acción se completó con éxito.
            cerrarModal();

            // Opcional: podríamos ocultar la tarjeta principal aquí
            // document.querySelector('.asesorias-grid .asesoria-card').style.display = 'none';
        }

        // Cierra el modal si se clickea en el sombreado oscuro trasero
        document.getElementById('modalRegistro').addEventListener('click', function (e) {
            if (e.target === this) {
                cerrarModal();
            }
        });
    </script>

    <%- include('templates/footer.ejs') %>