<%- include('templates/headerPanel.ejs', { rol: rol }) %>

<style>
    .supervisar-stats .card-header-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin-bottom: 8px;
    }

    .supervisar-stats .stat-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 20px 25px;
    }

    .supervisar-stats .stat-card p {
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
    }
</style>

<div class="supervisar-container">
    <div class="supervisar-header">
        <h1>Historial de asesorías</h1>
        <p>Registro de todas las sesiones completadas</p>
    </div>

    <!-- Estadísticas -->
    <div class="supervisar-stats">
        <div class="stat-card">
            <div style="display:flex; justify-content:space-between; align-items:center; width:100%; margin-bottom:8px;">
                <h4 style="margin:0; font-size:0.9rem; color:#333;">Total de sesiones       </h4>
                <i class="fas fa-history icon-total fa-lg"></i>
            </div>
            <p style="font-size:2rem; font-weight:700; margin:0;"><%= typeof total !== 'undefined' ? total : 0 %></p>
        </div>
        <div class="stat-card">
            <div style="display:flex; justify-content:space-between; align-items:center; width:100%; margin-bottom:8px;">
                <h4 style="margin:0; font-size:0.9rem; color:#333;">Tiempo total      </h4>
                <i class="fas fa-clock icon-total fa-lg"></i>
            </div>
            <p style="font-size:2rem; font-weight:700; margin:0;"><%= typeof tiempoTotal !== 'undefined' ? tiempoTotal : '0 min' %></p>
        </div>
    </div>

    <!-- Grid de asesorías -->
    <div class="asesorias-grid">
        <% if (typeof asesorias !== 'undefined' && asesorias.length > 0) { %>
            <% asesorias.forEach(function(asesoria, index) { %>
                <div class="asesoria-card" style="cursor: pointer;" onclick="abrirModal(<%= index %>)">
                    <div class="card-header-info">
                        <h3><%= asesoria.materia %></h3>
                        <span class="status-badge badge-green">Completada</span>
                    </div>

                    <div class="card-users">
                        <span>
                            <% if (rol === 'Asesor') { %>Estudiante:<% } else { %>Asesor:<% } %>
                            <%= asesoria.contraparte %>
                            <br>
                            Tema: <%= asesoria.tema %>
                        </span>
                    </div>

                    <div class="card-footer">
                        <div class="card-datetime">
                            <span><i class="far fa-calendar-alt"></i> <%= asesoria.fecha %></span>
                            <span><i class="far fa-clock"></i> <%= asesoria.hora_in %> - <%= asesoria.hora_fin %></span>
                        </div>
                        <div>
                            <% for (let i = 0; i < 5; i++) { %>
                                <% if (i < (asesoria.calificacion || 0)) { %>
                                    <i class="fas fa-paw" style="color: #f1c40f;"></i>
                                <% } else { %>
                                    <i class="fas fa-paw" style="color: #ccc;"></i>
                                <% } %>
                            <% } %>
                            <small><%= asesoria.calificacion || 0 %>/5</small>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p style="color:#aaa; padding:30px; text-align:center;">No tienes asesorías completadas en tu historial.</p>
        <% } %>
    </div>
</div>

<!-- Modal -->
<div id="modalAsesoria" class="editarUsuario ocultar">
    <div class="asesoria-card" style="width: 90%; max-width: 600px;">
        <div class="card-header-info">
            <h3 id="modalMateria" style="font-size: 1.5rem;"></h3>
            <span class="status-badge badge-green">Completada</span>
        </div>
        <div class="card-users" style="font-size: 1rem; margin-top: 10px;">
            <span id="modalContraparte"></span><br>
            <span id="modalTema"></span>
        </div>
        <div class="card-footer" style="margin-top: 20px;">
            <div class="card-datetime" style="font-size: 1rem;">
                <span id="modalFecha"></span>
                <span id="modalTiempo"></span>
            </div>
            <div id="modalStars" style="font-size: 1.2rem;"></div>
        </div>
        <div class="contenedor-botones" style="margin-top: 20px;">
            <button type="button" class="btn-cancelar" onclick="cerrarModal()">Cerrar detalles</button>
        </div>
    </div>
</div>

<script id="asesorias-data" type="text/template">
    <%- JSON.stringify(typeof asesorias !== 'undefined' ? asesorias : []) %>
</script>

<script>
    const asesoriasData = JSON.parse(document.getElementById('asesorias-data').textContent);
    const rolActual = '<%= rol %>';

    function abrirModal(index) {
        const d = asesoriasData[index];
        if (!d) return;

        let starsHtml = '';
        const calif = d.calificacion || 0;
        for (let i = 0; i < 5; i++) {
            starsHtml += i < calif
                ? '<i class="fas fa-paw" style="color:#f1c40f;"></i> '
                : '<i class="fas fa-paw" style="color:#ccc;"></i> ';
        }

        document.getElementById('modalMateria').innerText = d.materia;
        document.getElementById('modalContraparte').innerText = (rolActual === 'Asesor' ? 'Estudiante: ' : 'Asesor: ') + d.contraparte;
        document.getElementById('modalTema').innerText = 'Tema: ' + d.tema;
        document.getElementById('modalFecha').innerHTML = '<i class="fas fa-calendar-alt"></i> ' + d.fecha;
        document.getElementById('modalTiempo').innerHTML = '<i class="fas fa-clock"></i> ' + d.hora_in + ' - ' + d.hora_fin;
        document.getElementById('modalStars').innerHTML = starsHtml + '<small>' + calif + '/5</small>';
        document.getElementById('modalAsesoria').classList.remove('ocultar');
    }

    function cerrarModal() {
        document.getElementById('modalAsesoria').classList.add('ocultar');
    }

    document.getElementById('modalAsesoria').addEventListener('click', function(e) {
        if (e.target === this) cerrarModal();
    });
</script>

<%- include('templates/footer.ejs') %>