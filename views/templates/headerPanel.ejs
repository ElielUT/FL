<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LobiFind</title>
    <link rel="icon" href="images/Logo.png">
    <link rel="stylesheet" href="styles/estilos.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
</head>

<body>
    <header class="top-bar">
        <div class="volverIcon" id="volver" onclick="window.history.back()">
            <i class="bi bi-caret-left-square-fill"></i>
            <p>Volver</p>
        </div>
        <div class="titulo-panel">
            <h4>Panel de <%= typeof rol !=='undefined' ? rol : 'Usuario' %>
            </h4>
        </div>
        <div class="header-actions">
            <% if (typeof rol !=='undefined' && rol.toLowerCase()==='asesorado' ) { %>
                <!-- Botón Perfil -->
                <a href="/perfil-<%= (typeof rol !== 'undefined' && rol.toLowerCase() === 'asesor') ? 'asesor' : 'asesorado' %>"
                    class="action-btn">
                    <i class="bi bi-person"></i>
                    <span>Perfil</span>
                </a>
                <% } %>
                    <div class="close-icon" id="cerrar" onclick="window.location.href='/'">&times;</div>
        </div>
    </header>