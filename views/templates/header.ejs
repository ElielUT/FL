<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LobiFind</title>
    <link rel="icon" href="/images/Logo.png">
    <link rel="stylesheet" href="/styles/estilos.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Montserrat', sans-serif; }
        body { background-color: #f7f9fa; min-height: 100vh; display: flex; flex-direction: column; }
        .top-bar {
            background-color: #0fb88f;
            color: white;
            padding: 15px 40px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            position: sticky;
            top: 0;
            z-index: 100;
            width: 100%;
        }
        .header-actions {
            display: flex;
            align-items: center;
            gap: 25px;
        }
        .action-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: white;
            text-decoration: none;
            font-size: 12px;
            font-weight: 600;
            gap: 4px;
            transition: opacity 0.2s;
            background: none;
            border: none;
            cursor: pointer;
        }
        .action-btn:hover { opacity: 0.8; }
        .action-btn i { font-size: 22px; }
    </style>
</head>

<body>
    <header class="top-bar">
        <div class="header-actions">
            <a href="/perfil-asesorado" class="action-btn" id="btnPerfil" style="display:none;">
                <i class="fa-regular fa-user"></i>
                <span>Perfil</span>
            </a>
            <a href="/borrarSesion" class="action-btn">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Salir</span>
            </a>
        </div>
    </header>
    <script>
        // Mostrar el botón de perfil correcto según la sesión
        fetch('/sesion-info').then(r => r.json()).then(data => {
            const btn = document.getElementById('btnPerfil');
            if (data.rol === 1) {
                btn.href = '/perfil-asesor';
                btn.style.display = 'flex';
            } else if (data.rol === 2) {
                btn.href = '/perfil-asesorado';
                btn.style.display = 'flex';
            }
        }).catch(() => {});
    </script>