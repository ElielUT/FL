<%- include('templates/header.ejs') %>

<div class="agendar-container">
    <div class="agendar-header">
        <h1>Agendar asesoría</h1>
        <p>Completa los siguientes datos para programar tu asesoría</p>
    </div>

    <div class="agendar-card">
        <div class="materia-info">
            <h2><%= materiaNombre %></h2>
            <!-- <p>ID de materia: <%= materiaId %></p> -->
        </div>

        <form action="/crear-solicitud" method="POST" class="agendar-form">
            <input type="hidden" name="materiaId" value="<%= materiaId %>">
            <input type="hidden" name="materiaNombre" value="<%= materiaNombre %>">

            <div class="form-group">
                <label for="asesor">Selecciona un asesor:</label>
                <select name="id_asesor" id="asesor" required>
                    <option value="">-- Selecciona un asesor --</option>
                    <% if (asesores && asesores.length > 0) { %>c
                        <% asesores.forEach(asesor => { %>
                            <option value="<%= asesor.id_asesor %>">
                                <% if (asesor.usuario && asesor.usuario.nombres) { %>
                                    <%= asesor.usuario.nombres %> <%= asesor.usuario.apellidos %> - <%= asesor.carrera %>
                                <% } else if (asesor.nombres) { %>
                                    <%= asesor.nombres %> <%= asesor.apellidos %> - <%= asesor.carrera %>
                                <% } else { %>
                                    Asesor ID: <%= asesor.id_asesor %> - <%= asesor.carrera %>
                                <% } %>
                            </option>
                        <% }) %>
                    <% } else { %>
                        <option value="" disabled>No hay asesores disponibles para esta materia</option>
                    <% } %>
                </select>
            </div>

            <div class="form-group">
                <label for="tema">Tema de la asesoría:</label>
                <textarea name="tema" id="tema" rows="3" placeholder="Describe brevemente el tema que necesitas ayuda..." required></textarea>
                <div class="form-group">
                    <label>Modalidad:</label>
                    <div class="modalidad-opciones">
                        <label class="modalidad-opcion">
                            <input type="radio" name="modalidad" value="virtual" checked>
                            <span><i class="fas fa-video"></i> Virtual</span>
                        </label>
                        <label class="modalidad-opcion">
                            <input type="radio" name="modalidad" value="presencial">
                            <span><i class="fas fa-map-marker-alt"></i> Presencial</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-group" id="slotsContainer" style="display:none;">
                <label>Horario disponible:</label>
                <div id="slotsList" class="slots-grid"></div>
                <input type="hidden" name="fecha" id="fechaHidden">
                <input type="hidden" name="hora_in" id="horaInHidden">
                <input type="hidden" name="hora_fin" id="horaFinHidden">
                <input type="hidden" name="id_horario" id="idHorarioHidden">
                <p id="sinSlots" style="color:#aaa; display:none;">Este asesor no tiene horarios disponibles.</p>
            </div>

            <div class="botones-accion">
                <button type="button" class="btn-cancelar" onclick="window.history.back()">Cancelar</button>
                <button type="submit" class="btn-guardar" <%= (asesores && asesores.length > 0) ? '' : 'disabled' %>>Enviar solicitud</button>
            </div>
        </form>
    </div>
</div>

<style>
.agendar-container {
    width: 90%;
    max-width: 700px;
    margin: 40px auto;
}

.agendar-header h1 {
    font-size: 2rem;
    margin-bottom: 10px;
    color: #333;
}

.agendar-header p {
    color: #666;
    margin-bottom: 30px;
}

.agendar-card {
    background: white;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.materia-info {
    background: #f0f7f5;
    padding: 15px;
    border-radius: 12px;
    margin-bottom: 25px;
    border-left: 4px solid var(--clr-admin);
}

.materia-info h2 {
    margin: 0 0 5px 0;
    color: var(--clr-admin);
}

.materia-info p {
    margin: 0;
    color: #666;
    font-size: 0.85rem;
}

.agendar-form .form-group {
    margin-bottom: 20px;
}

.agendar-form label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: #333;
}

.agendar-form select,
.agendar-form textarea,
.agendar-form input {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 10px;
    font-size: 0.95rem;
    font-family: inherit;
}

.agendar-form select:focus,
.agendar-form textarea:focus,
.agendar-form input:focus {
    outline: none;
    border-color: var(--clr-admin);
    box-shadow: 0 0 0 3px rgba(0, 161, 133, 0.1);
}

.form-row {
    display: flex;
    gap: 20px;
}

.form-row .form-group {
    flex: 1;
}

.botones-accion {
    display: flex;
    justify-content: flex-end;
    gap: 15px;
    margin-top: 25px;
}

.btn-cancelar {
    background: #e0e0e0;
    color: #666;
    padding: 10px 25px;
    border: none;
    border-radius: 25px;
    cursor: pointer;
}

.btn-guardar {
    background: linear-gradient(90deg, var(--clr-admin), #4db6ac);
    color: white;
    padding: 10px 25px;
    border: none;
    border-radius: 25px;
    cursor: pointer;
    font-weight: bold;
}

.btn-guardar:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.modalidad-opciones {
    display: flex;
    gap: 16px;
    margin-top: 8px;
}

.modalidad-opcion {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f5f5f5;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    padding: 10px 20px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s;
}

.modalidad-opcion:has(input:checked) {
    border-color: #4db6ac;
    background: #e0f2f1;
    color: #00897b;
}

.modalidad-opcion input {
    display: none;
}

.slots-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
}

.slot-btn {
    background: #f5f5f5;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    padding: 10px 16px;
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 500;
    transition: all 0.2s;
}

.slot-btn:hover {
    border-color: #4db6ac;
    background: #e0f2f1;
}

.slot-selected {
    border-color: #4db6ac !important;
    background: #4db6ac !important;
    color: white !important;
}

</style>

<script>
    const selectAsesor = document.getElementById('asesor');
    selectAsesor.addEventListener('change', async function() {
        const idAsesor = this.value;
        const container = document.getElementById('slotsContainer');
        const slotsList = document.getElementById('slotsList');
        const sinSlots = document.getElementById('sinSlots');

        if (!idAsesor) {
            container.style.display = 'none';
            return;
        }

        slotsList.innerHTML = '<p style="color:#aaa;">Cargando horarios...</p>';
        container.style.display = 'block';
        sinSlots.style.display = 'none';

        try {
            const resp = await fetch(`/slots/${idAsesor}`);
            const data = await resp.json();
            const slots = data.slots || [];

            slotsList.innerHTML = '';

            if (slots.length === 0) {
                sinSlots.style.display = 'block';
                return;
            }

            slots.forEach((slot, i) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'slot-btn';
                btn.textContent = slot.label;
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('slot-selected'));
                    this.classList.add('slot-selected');
                    document.getElementById('fechaHidden').value = slot.fecha_raw;
                    document.getElementById('horaInHidden').value = slot.hora_in + ':00';
                    document.getElementById('horaFinHidden').value = slot.hora_fin + ':00';
                    document.getElementById('idHorarioHidden').value = slot.id_horario;
                });
                slotsList.appendChild(btn);
            });
        } catch(e) {
            slotsList.innerHTML = '<p style="color:#f28b82;">Error al cargar horarios.</p>';
        }
    });
</script>

<%- include('templates/footer.ejs') %>